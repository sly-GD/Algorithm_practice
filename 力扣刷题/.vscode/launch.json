{
    
    "version": "0.2.0",
    "configurations": [

        {   
            
        
        
        
        "miDebuggerPath": "F:\\mingw64\\bin\\gdb.exe",//!!!!!!,看这里，//！！！！将路径名，替换 xxxxx,再将 \ 换成 \\ 
            
            
            
            
            
            "name": "(gdb) Launch",
            "preLaunchTask": ":C/C++:编译生成文件",//同文件夹中tasks.json中的label里的字段
            "type": "cppdbg",//配置类型
            "request": "launch",//请求配置类型
            "program": "${fileDirname}\\${fileBasenameNoExtension}.exe",//调试程序的路径
            "args": [],//调试传递参数
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,//true显示外置的控制台窗口，false显示内置终端
            "MIMode": "gdb",
            
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        }
    ]
}