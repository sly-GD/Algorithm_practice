{
    "tasks": [
        {
            "type": "cppbuild",
            "label": "C/C++:编译生成文件",
           
           
           
            "command": "F:\\mingw64x\\bin\\g++.exe",//！！！！将路径名，替换 xxxxx,再将 \ 换成 \\ 
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "${fileDirname}\\*.cpp",
                "-o",
                "${fileDirname}\\${fileBasenameNoExtension}.exe"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "调试器生成的任务。"
        }
    ],
    "version": "2.0.0"
}